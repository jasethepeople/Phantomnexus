# YouTube Sentinel API Service Configuration

# Server settings
SERVER_PORT=8080
SERVER_HOST=0.0.0.0
READ_TIMEOUT=30s
WRITE_TIMEOUT=30s

# gRPC backend
GRPC_ADDRESS=localhost:50051
GRPC_TIMEOUT=10s
GRPC_RETRY_ATTEMPTS=3
GRPC_RETRY_BACKOFF=500ms

# Redis
REDIS_ADDRESS=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# Authentication
API_KEY=your-secret-api-key-here

# CORS
CORS_ALLOWED_ORIGINS=*

# Rate limiting
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW=1m

# Upload settings
UPLOAD_MAX_SIZE=10737418240
ALLOWED_VIDEO_TYPES=video/mp4,video/quicktime,video/x-msvideo,video/x-matroska,video/webm

# Logging
LOG_LEVEL=info

# WebSocket
WEBSOCKET_PING_INTERVAL=30s
WEBSOCKET_WRITE_TIMEOUT=10s
